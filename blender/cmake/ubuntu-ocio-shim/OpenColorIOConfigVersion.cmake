# Version reported by pkg-config for Ubuntu 24.04's libopencolorio-dev.
execute_process(COMMAND pkg-config --modversion OpenColorIO
  OUTPUT_VARIABLE PACKAGE_VERSION OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT PACKAGE_VERSION)
  set(PACKAGE_VERSION 2.1.3)
endif()
if(PACKAGE_FIND_VERSION VERSION_LESS_EQUAL PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
else()
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
endif()
