+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup edobj
+ *
+ * Example operator added by the fork. It exists to demonstrate the smallest
+ * possible C++ feature: a new file, one registration line, callable from
+ * Python as `bpy.ops.object.fork_hello()`.
+ */
+
+#include "DNA_object_types.h"
+
+#include "BKE_context.hh"
+#include "BKE_report.hh"
+
+#include "WM_api.hh"
+#include "WM_types.hh"
+
+#include "ED_screen.hh"
+
+#include "object_intern.hh"
+
+namespace blender::ed::object {
+
+static wmOperatorStatus fork_hello_exec(bContext *C, wmOperator *op)
+{
+  const Object *ob = CTX_data_active_object(C);
+  if (ob == nullptr) {
+    BKE_report(op->reports, RPT_INFO, "Hello from the fork: no active object");
+    return OPERATOR_FINISHED;
+  }
+  BKE_reportf(op->reports, RPT_INFO, "Hello from the fork: active object is \"%s\"", ob->id.name + 2);
+  return OPERATOR_FINISHED;
+}
+
+void OBJECT_OT_fork_hello(wmOperatorType *ot)
+{
+  /* Identifiers. */
+  ot->name = "Fork Hello";
+  ot->description = "Report the active object (example operator added by the fork)";
+  ot->idname = "OBJECT_OT_fork_hello";
+
+  /* API callbacks. */
+  ot->exec = fork_hello_exec;
+  ot->poll = ED_operator_objectmode;
+
+  /* Flags. */
+  ot->flag = OPTYPE_REGISTER;
+}
+
+}  // namespace blender::ed::object
diff --git a/source/blender/editors/object/object_intern.hh b/source/blender/editors/object/object_intern.hh
