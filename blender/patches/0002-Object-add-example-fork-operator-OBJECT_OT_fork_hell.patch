 .../editors/object/object_fork_example.cc     | 53 +++++++++++++++++++
 .../blender/editors/object/object_intern.hh   |  4 ++
 source/blender/editors/object/object_ops.cc   |  1 +
 4 files changed, 59 insertions(+)
 create mode 100644 source/blender/editors/object/object_fork_example.cc

